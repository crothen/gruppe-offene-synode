# Copy to functions/.env and fill in. The .env file is not committed.
# Any SMTP account works (e.g. the church mail server, or a Gmail address with an app password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=website@example.com
SMTP_PASS=change-me
MAIL_FROM="Daniel Nater, Gruppe Offene Synode <website@example.com>"
# Optional: replies go here instead of the sending mailbox
MAIL_REPLY_TO="Daniel Nater <daniel.nater@quickline.ch>"
# Who gets notified about new requests (comma-separated). Unset = all admins with role "admin".
NOTIFY_TO=daniel.nater@quickline.ch
SITE_URL=https://gruppe-offene-synode.web.app
