rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Flags are set on the login token by the refreshMyClaims function
    // (admins listed in gos-admins, members listed in gos-members).
    match /gos-documents/{fileName} {
      allow read: if request.auth != null && (request.auth.token.member == true || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
