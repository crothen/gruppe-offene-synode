rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdminUser() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/gos-admins/$(request.auth.uid));
    }
    function isMember() {
      return isAdminUser()
        || (request.auth != null && 'email' in request.auth.token
            && firestore.exists(/databases/(default)/documents/gos-members/$(request.auth.token.email.lower())));
    }

    // Document files: members read, admins write
    match /gos-documents/{fileName} {
      allow read: if isMember();
      allow write: if isAdminUser();
    }
  }
}
