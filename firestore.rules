rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Anyone listed in gos-admins (role admin or editor) may use the admin portal.
    function isAdminUser() {
      return signedIn() && exists(/databases/$(database)/documents/gos-admins/$(request.auth.uid));
    }
    function isFullAdmin() {
      return isAdminUser()
        && get(/databases/$(database)/documents/gos-admins/$(request.auth.uid)).data.role == "admin";
    }
    function hasEmail() {
      return signedIn() && 'email' in request.auth.token;
    }
    // Members are listed in gos-members by lower-cased e-mail address.
    function isMember() {
      return isAdminUser()
        || (hasEmail() && exists(/databases/$(database)/documents/gos-members/$(request.auth.token.email.lower())));
    }

    // Events: public
    match /gos-events/{eventId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    // Section texts and people: public, admins edit
    match /gos-content/{docId} {
      allow read: if true;
      allow write: if isAdminUser();
    }
    match /gos-people/{personId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    // Documents: members only
    match /gos-documents/{docId} {
      allow read: if isMember();
      allow write: if isAdminUser();
    }

    // Admin list: admins see all, everyone may check their own entry
    match /gos-admins/{userId} {
      allow read: if isAdminUser() || (signedIn() && request.auth.uid == userId);
      allow write: if isFullAdmin();
    }

    // Membership requests: a signed-in user files one for themselves, admins decide
    match /gos-requests/{userId} {
      allow read: if isFullAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId && hasEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120;
      allow update, delete: if isFullAdmin();
    }

    // Member list: admins manage, everyone may check their own entry
    match /gos-members/{email} {
      allow read: if isFullAdmin() || (hasEmail() && request.auth.token.email.lower() == email);
      allow write: if isFullAdmin();
    }
  }
}
